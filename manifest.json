{
  "manifest_version": 3,
  "name": "NEXUS",
  "version": "1.0.0",
  "description": "Extract weekly automation stability data from Superset — OKR, Weekly, Monthly",
  "permissions": ["activeTab", "scripting", "tabs", "downloads"],
  "host_permissions": ["https://superset.cc-tooling.cctools.capillarytech.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "NEXUS — Click to open"
  },

  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
